# Copy to .env and fill in real values. Never commit .env.
# Supabase Dashboard -> Connect -> "ORMs" / connection string.

# --- Database (Supabase Postgres via Prisma) ---
# App runtime: transaction pooler, port 6543, keep ?pgbouncer=true.
DATABASE_URL="postgres://[DB-USER].[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Prisma CLI / migrations: session pooler (port 5432) or direct connection.
DIRECT_URL="postgres://[DB-USER].[PROJECT-REF]:[PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Claude (brief analysis) ---
ANTHROPIC_API_KEY=""

# --- PayPal (Sandbox) ---
# developer.paypal.com -> Apps & Credentials -> Sandbox app. Only "sandbox" or "live".
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Same client id, exposed to the browser for the PayPal JS SDK buttons.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Public origin of the app, used for client proposal links (/proposals/view/<token>).
APP_BASE_URL="http://localhost:3000"
